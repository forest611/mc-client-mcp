{
  "schemaVersion": 1,
  "id": "mc-client-mcp",
  "version": "${version}",
  "name": "MC Client MCP",
  "description": "Exposes the Minecraft client over MCP so that an agent can drive it for unattended plugin verification.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.forest611.mcclientmcp.McClientMcpMod"
    ]
  },
  "mixins": [
    "mc-client-mcp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  }
}
